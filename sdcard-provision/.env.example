# Copy to .env in this directory (gitignored, never commit it) and fill in
# real values. provision.ps1 and provision_local.ps1 read this file and
# substitute the placeholders into firstrun.sh before it's written to the SD
# card's boot partition. Without a .env present, the scripts leave the
# __PICAM_*__ placeholders in place and the Pi will not provision correctly.
PICAM_SSID=your-hotspot-ssid
PICAM_PSK=your-hotspot-password
PICAM_USER_PASSWORD=your-pi-login-password
